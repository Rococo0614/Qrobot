# 只为所选后端填写对应凭据。不要提交本文件的真实副本。
# 后端通常在 qrobot.json 中选择；只有需要临时覆盖时才取消下一行注释。
# QROBOT_LLM_BACKEND=opencode

# DeepSeek API 后端
DEEPSEEK_API_KEY=

# OpenAI 官方 API 后端（ChatGPT 订阅不等于 API 额度）
OPENAI_API_KEY=

# OneBot 访问令牌（如果 NapCat 中启用了令牌）
ONEBOT_ACCESS_TOKEN=

# Copilot SDK 在无交互环境中可选用；本机登录时通常不需要。
COPILOT_GITHUB_TOKEN=

# 可选覆盖
# QROBOT_CONFIG=qrobot.json
# QROBOT_QQ_BACKEND=onebot
# QROBOT_DRY_RUN=true
# QROBOT_OPENCODE_MODEL=openai/gpt-5.6-sol
